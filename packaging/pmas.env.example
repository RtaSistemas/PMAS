# PMAS settings. The service reads /etc/pmas/pmas.env.
# Remove the "#" at the start of a line to change a setting.

# Address and port. 127.0.0.1 accepts only local connections (use a reverse proxy).
# PMAS_HOST=127.0.0.1
# PMAS_PORT=8765

# Data
PMAS_DB_PATH=/var/lib/pmas/pmas.db
PMAS_BACKUP_DIR=/var/lib/pmas/backups
# PMAS_BACKUP_RETENTION=30

# Logs
# PMAS_LOG_LEVEL=INFO
PMAS_LOG_FILE=/var/log/pmas/pmas.log

# Limits
# PMAS_MAX_UPLOAD_MB=20
# PMAS_UPLOAD_RATE_LIMIT=60/minute
# PMAS_LOGIN_RATE_LIMIT=30/minute

# Other addresses that browsers use to open PMAS (comma-separated)
# PMAS_ALLOWED_ORIGINS=https://pmas.example.com
