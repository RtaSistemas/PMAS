# PMAS environment configuration
# Copy this file to .env and fill in the values before starting the service.

# ── Server ────────────────────────────────────────────────────────────────────
PMAS_PORT=8765
PMAS_WORKERS=2

# ── Logging ───────────────────────────────────────────────────────────────────
PMAS_LOG_LEVEL=INFO
PMAS_LOG_LEVEL_UVICORN=warning
PMAS_LOG_FILE=/var/log/pmas/pmas.log

# ── Database ──────────────────────────────────────────────────────────────────
PMAS_DB_PATH=/opt/pmas/pmas.db
PMAS_DB_POOL_SIZE=5
PMAS_DB_MAX_OVERFLOW=10

# ── CORS (comma-separated list of allowed origins beyond localhost) ────────────
PMAS_ALLOWED_ORIGINS=
