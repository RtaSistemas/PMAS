# ─── Segurança ────────────────────────────────────────────────────────────────
# Chave JWT — obrigatória em produção. Gere com:
#   python -c "import secrets; print(secrets.token_hex(32))"
PMAS_SECRET_KEY=

# ─── Servidor ─────────────────────────────────────────────────────────────────
# Porta de escuta (padrão: 8765)
PMAS_PORT=8765

# Interface de rede (padrão: 127.0.0.1 = apenas local)
# Use 0.0.0.0 para expor na rede interna / atrás de Nginx
PMAS_HOST=127.0.0.1

# Modo de execução: development (reload automático) | production
PMAS_ENV=development

# ─── CORS ─────────────────────────────────────────────────────────────────────
# Origens adicionais permitidas, separadas por vírgula
# Ex: https://pmas.empresa.com,http://192.168.1.100:8765
PMAS_ALLOWED_ORIGINS=

# ─── Banco de dados ───────────────────────────────────────────────────────────
# Caminho do arquivo SQLite (padrão: pmas.db na raiz do projeto)
# Ex: /data/pmas/pmas.db
PMAS_DB_PATH=

# ─── Logs ─────────────────────────────────────────────────────────────────────
# Nível de log: DEBUG | INFO | WARNING | ERROR (padrão: INFO)
PMAS_LOG_LEVEL=INFO
