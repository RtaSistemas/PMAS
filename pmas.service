[Unit]
Description=PMAS — Project Management Assistant System
Documentation=https://github.com/rtasistemas/pmas
After=network.target
Wants=network.target

[Service]
Type=simple
User=pmas
Group=pmas
WorkingDirectory=/opt/pmas

# Environment file — copy /opt/pmas/.env.example to /opt/pmas/.env and fill in values
EnvironmentFile=/opt/pmas/.env

ExecStart=/opt/pmas/.venv/bin/uvicorn \
    backend.app.main:app \
    --host 127.0.0.1 \
    --port ${PMAS_PORT:-8765} \
    --workers ${PMAS_WORKERS:-2} \
    --log-level ${PMAS_LOG_LEVEL_UVICORN:-warning}

# Restart on failure with backoff
Restart=on-failure
RestartSec=5s
StartLimitInterval=60s
StartLimitBurst=3

# Security hardening
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/opt/pmas /var/log/pmas

# Resource limits
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
